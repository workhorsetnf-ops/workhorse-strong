{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push-reminders?slot=morning",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/push-reminders?slot=evening",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/push-agenda",
      "schedule": "*/5 * * * *"
    }
  ]
}
